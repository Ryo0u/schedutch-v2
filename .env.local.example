# ローカル開発用の環境変数サンプル。`.env.local` の既定値でもある（npm run env:local でコピーされる）。
# `npm run db:start` 実行後に表示される値と一致する（`supabase status` で再確認可能）。
#
# 本番に向き先を切り替える場合は、Supabaseダッシュボードの値を
# .env.local.production（gitignore対象、各自の手元にのみ置く）に記載し、
# npm run env:prod でコピーする。

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
